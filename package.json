{
  "name": "worklog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node scripts/css-module-types.ts --check && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:rules": "node scripts/check-rule-coverage.ts",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test --project=chromium",
    "test:e2e:all": "NODE_OPTIONS=--conditions=react-server playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "css:types": "node scripts/css-module-types.ts",
    "test:tz": "bash scripts/test-time-zones.sh",
    "test:bundle": "node scripts/scan-client-bundle.ts"
  },
  "dependencies": {
    "kysely": "0.29.8",
    "markdown-it": "15.0.3",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
