# Copy to .env.local and fill in. Never commit real values.
APP_URL=http://localhost:3000
APP_TIME_ZONE=Africa/Kampala

# Local: the Docker Postgres from compose.yaml (port 5433). Production: Neon.
DATABASE_URL=postgres://worklog:worklog@127.0.0.1:5433/worklog
# Neon non-pooled endpoint, used only by migrations.
DATABASE_URL_DIRECT=postgres://worklog:worklog@127.0.0.1:5433/worklog

# GitHub OAuth App (callback: {APP_URL}/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Your numeric GitHub user id: https://api.github.com/users/{login} → "id"
ALLOWED_GITHUB_USER_ID=

# Fine-grained token, organisation as resource owner, read-only "Pull requests"
GITHUB_PR_TOKEN=
GITHUB_ALLOWED_ORGS=your-org

REPORT_AUTHOR_NAME=Your Name
